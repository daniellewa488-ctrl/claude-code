# ── Email (IMAP – incoming) ──────────────────────────────────────────────────
IMAP_HOST=imap.strato.de
IMAP_PORT=993
IMAP_USER=deine@email.de
IMAP_PASS=dein-email-passwort

# ── Email (SMTP – outgoing) ──────────────────────────────────────────────────
SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_USER=deine@email.de
SMTP_PASS=dein-email-passwort

# ── AI APIs ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx # https://console.anthropic.com

# ── STRATO SFTP ───────────────────────────────────────────────────────────────
STRATO_SFTP_HOST=ssh.strato.de
STRATO_SFTP_USER=dein-sftp-benutzer
STRATO_SFTP_PASS=dein-sftp-passwort
STRATO_SFTP_ROOT=/httpdocs

# ── Preview-URL (deine Domain) ────────────────────────────────────────────────
PREVIEW_BASE_URL=https://www.hannahs-webdesign.de

# ── Polling-Intervall in Sekunden (Standard: 120) ────────────────────────────
POLL_INTERVAL_SECONDS=120
